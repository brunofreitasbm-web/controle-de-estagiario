# URL do projeto do Supabase (ex: https://xyz.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Chave anônima / pública (anon/public key) do Supabase
VITE_SUPABASE_ANON_KEY=your-anon-key

# NÃO adicione chaves de API de terceiros aqui (Gemini, etc.) com o prefixo
# VITE_ — qualquer variável VITE_* vai para o bundle do navegador e fica
# pública. A chave do Gemini usada pela sincronização Grupo IB é lida como
# segredo da Edge Function (GEMINI_API_KEY via `supabase secrets set`), nunca
# como variável de build do front-end.

# Qual workspace este deploy representa (ver src/config/branding.js).
# 'porto-terapia' (padrão) ou 'grupoib'. Os dois deploys compartilham o mesmo
# banco Supabase acima — o isolamento real dos dados é feito por RLS
# (workspace_scope em auth.users), não por esta variável, que só controla
# marca/branding e quais unidades aparecem no login do quiosque.
VITE_WORKSPACE_ID=porto-terapia
